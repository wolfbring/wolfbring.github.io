<body>
  <a class="skip-link" href="#main">跳到內容</a>
  <div class="shell">
    <header class="topbar" aria-label="頁首工具列">
      <div class="brand" aria-label="i世代測驗標誌">
        <div class="logo" aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 3v18"></path><path d="M8 7h8"></path><path d="M8 17h8"></path>
          </svg>
        </div>
        <div>
          <strong>你有多 i 世代？</strong>
          <span>15 題互動測驗網頁</span>
        </div>
      </div>
      <button class="theme-toggle" type="button" data-theme-toggle aria-label="切換深色模式">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>
      </button>
    </header>

    <main id="main">
      <section class="hero">
        <div class="panel hero-copy">
          <span class="eyebrow">YES / NO GENERATION QUIZ</span>
          <h1>回答 15 題，看看你的行為、態度與觀念有多接近 i 世代。</h1>
          <p>每題只要選「是」或「否」，系統會自動累計分數，並在完成後顯示你的結果判讀。這是一個偏向互動展示的自評工具，不是正式心理測驗。</p>
          <div class="actions">
            <button class="btn btn-primary" type="button" id="scrollStart">開始作答</button>
            <button class="btn btn-secondary" type="button" id="autoCheck">檢查是否完成</button>
          </div>
        </div>
        <aside class="panel hero-side" aria-label="計分說明">
          <div class="score-card">
            <div class="label">目前分數</div>
            <div class="score"><span id="scoreNow">0</span><span style="font-size:var(--text-lg);font-weight:700;color:var(--color-text-muted)"> / 15</span></div>
            <div class="meter" aria-hidden="true"><span id="meterBar"></span></div>
          </div>
          <div class="legend">
            <div>第 1、2、5、8、11、12、13、14、15 題：答「是」得 1 分。</div>
            <div>第 3、4、6、7、9、10 題：答「否」得 1 分。</div>
            <div>分數越高，越趨近 i 世代。</div>
          </div>
        </aside>
      </section>

      <section class="layout">
        <form class="quiz" id="quizForm" novalidate>
        </form>

        <aside class="panel result" aria-live="polite" aria-atomic="true">
          <span class="badge">結果判讀</span>
          <h2 id="resultTitle">尚未完成作答</h2>
          <p id="resultText">請先完成 15 題，系統會顯示總分與對應的傾向說明。</p>
          <ul>
            <li><strong>0–5 分：</strong>較不趨近 i 世代</li>
            <li><strong>6–10 分：</strong>部分特徵接近 i 世代</li>
            <li><strong>11–15 分：</strong>明顯趨近 i 世代</li>
          </ul>
          <div class="actions">
            <button class="btn btn-primary" type="button" id="finishBtn">完成並判定</button>
            <button class="btn btn-secondary" type="reset" form="quizForm" id="resetBtn">重新作答</button>
          </div>
        </aside>
      </section>

      <p class="footer-note">題目與計分邏輯依照你提供的 15 題內容製作；其中 i 世代測驗的相同計分說明也可見於《Cheers》整理的文章與英文版題目說明。</p>
    </main>
  </div>

  <script>
    const questions = [
      '過去24小時內，你是否至少用了1小時在手機上傳訊息？',
      '你有智慧型手機上的社群軟體帳號嗎？',
      '你認為自己是有宗教信仰的人嗎？',
      '你滿17歲時已經擁有駕照嗎？',
      '你認為同性婚姻應該合法嗎？',
      '你滿16歲時喝過含酒精飲料嗎（小啜幾口不算）？',
      '你在青少年時期常和爸媽吵架嗎？',
      '你上中學時，學校裡種族背景和你不同的人是否超過三分之一？',
      '你上中學時，每個週末晚上是否都與朋友共度？',
      '你上中學時，有沒有在學期間打工？',
      '你是否同意人際間的安全距離及預先警示是好主意，並同意這樣能減低不經意的冒犯？',
      '你在政治上是獨立派嗎？',
      '你是否支持大麻合法化？',
      '追求不涉感情的性愛沒問題嗎？',
      '你上中學時，是否經常感覺被忽略並覺得寂寞？'
    ];

    const yesPoint = new Set([1,2,5,8,11,12,13,14,15]);
    const noPoint = new Set([3,4,6,7,9,10]);

    const form = document.getElementById('quizForm');
    const scoreNow = document.getElementById('scoreNow');
    const meterBar = document.getElementById('meterBar');
    const resultTitle = document.getElementById('resultTitle');
    const resultText = document.getElementById('resultText');

    questions.forEach((q, i) => {
      const index = i + 1;
      const scoreHint = yesPoint.has(index) ? '本題答「是」得 1 分' : '本題答「否」得 1 分';
      const card = document.createElement('section');
      card.className = 'panel question';
      card.innerHTML = `
        <header>
          <div class="num">${index}</div>
          <div>
            <div class="qtext">${q}</div>
            <div class="score-hint">${scoreHint}</div>
          </div>
        </header>
        <fieldset>
          <legend class="sr-only">第 ${index} 題作答</legend>
          <div class="choices">
            <div class="choice">
              <input type="radio" id="q${index}-yes" name="q${index}" value="yes">
              <label for="q${index}-yes">是</label>
            </div>
            <div class="choice">
              <input type="radio" id="q${index}-no" name="q${index}" value="no">
              <label for="q${index}-no">否</label>
            </div>
          </div>
        </fieldset>
      `;
      form.appendChild(card);
    });

    function getAnswers() {
      return questions.map((_, i) => {
        const idx = i + 1;
        const checked = form.querySelector(`input[name="q${idx}"]:checked`);
        return checked ? checked.value : null;
      });
    }

    function calculateScore() {
      const answers = getAnswers();
      let score = 0;
      answers.forEach((value, i) => {
        const idx = i + 1;
        if (yesPoint.has(idx) && value === 'yes') score += 1;
        if (noPoint.has(idx) && value === 'no') score += 1;
      });
      return { score, completed: answers.every(Boolean), answered: answers.filter(Boolean).length };
    }

    function renderStatus() {
      const { score, completed, answered } = calculateScore();
      scoreNow.textContent = score;
      meterBar.style.width = `${(score / 15) * 100}%`;

      if (!completed) {
        resultTitle.textContent = `目前已完成 ${answered} / 15 題`;
        resultText.textContent = '請繼續完成所有題目；完成後按下「完成並判定」即可看到你的傾向結果。';
        return;
      }

      applyResult(score);
    }

    function applyResult(score) {
      if (score <= 5) {
        resultTitle.textContent = `你的總分是 ${score} 分：較不趨近 i 世代`;
        resultText.textContent = '你的生活經驗、價值觀與行為模式，與這份測驗定義的 i 世代重疊相對較少。';
      } else if (score <= 10) {
        resultTitle.textContent = `你的總分是 ${score} 分：部分特徵接近 i 世代`;
        resultText.textContent = '你與 i 世代有明顯交集，但不是全面重疊，屬於中間偏近的類型。';
      } else {
        resultTitle.textContent = `你的總分是 ${score} 分：明顯趨近 i 世代`;
        resultText.textContent = '你的答題型態在行為、態度與觀念上，和這份測驗所描述的 i 世代特徵相當接近。';
      }
    }

    form.addEventListener('change', renderStatus);
    form.addEventListener('reset', () => {
      requestAnimationFrame(() => {
        scoreNow.textContent = '0';
        meterBar.style.width = '0%';
        resultTitle.textContent = '尚未完成作答';
        resultText.textContent = '請先完成 15 題，系統會顯示總分與對應的傾向說明。';
      });
    });

    document.getElementById('finishBtn').addEventListener('click', () => {
      const { score, completed } = calculateScore();
      if (!completed) {
        renderStatus();
        const firstMissing = [...form.querySelectorAll('fieldset')].find((fs, i) => !form.querySelector(`input[name="q${i+1}"]:checked`));
        if (firstMissing) firstMissing.closest('.question').scrollIntoView({ behavior: 'smooth', block: 'center' });
        return;
      }
      applyResult(score);
      document.querySelector('.result').scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    });

    document.getElementById('scrollStart').addEventListener('click', () => {
      form.querySelector('.question')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });

    document.getElementById('autoCheck').addEventListener('click', renderStatus);

    (function(){
      const button = document.querySelector('[data-theme-toggle]');
      const root = document.documentElement;
      let theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      root.setAttribute('data-theme', theme);
      const renderIcon = () => {
        button.innerHTML = theme === 'dark'
          ? '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><circle cx="12" cy="12" r="5"></circle><path d="M12 1v2M12 21v2M4.22 4.22l1.42 1.42M18.36 18.36l1.42 1.42M1 12h2M21 12h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"></path></svg>'
          : '<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path></svg>';
        button.setAttribute('aria-label', theme === 'dark' ? '切換淺色模式' : '切換深色模式');
      };
      renderIcon();
      button.addEventListener('click', () => {
        theme = theme === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-theme', theme);
        renderIcon();
      });
    })();

    renderStatus();
  </script>
</body>
</html>
